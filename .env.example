# Local Postgres (docker-compose.yml defaults)
DATABASE_URL="postgresql://controltower:controltower@localhost:5432/control_tower?schema=public"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Optional public URL (production / preview)
# NEXTAUTH_URL="http://localhost:3000"

# Optional AI (deterministic fallbacks if unset)
# GEMINI_API_KEY=""
